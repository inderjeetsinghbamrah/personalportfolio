# =========================================================================
# INDERJEET SINGH BAMRAH PORTFOLIO — ENVIRONMENT CONFIGURATION
# =========================================================================

# Supabase PostgreSQL & Backend
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_PROJECT_REF=your_project_ref
NEXT_PUBLIC_SUPABASE_PROJECT_NAME=personalPortfolio

# Server-Only Secret Key (Used exclusively in server-side route handlers / admin actions)
# Never expose with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Administration Gate Passcode
ADMIN_PASSCODE=systems2026
ADMIN_DEFAULT_PASSCODE=systems2026

# Upstash Redis (Optional for distributed caching & rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
