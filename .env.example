# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_PROJECT_REF=your_project_id
NEXT_PUBLIC_SUPABASE_PROJECT_NAME=portfolio

# Server-only Secret Key (keep private, never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Redis / Upstash Cache Configuration (Optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin Authentication Passcode
ADMIN_DEFAULT_PASSCODE=your_secure_passcode_here
ADMIN_PASSCODE=your_secure_passcode_here
